<?xml version="1.0" encoding="utf-8"?>
<!--
  Folia local-media loopback streaming:
  the WebView page is served over https (Capacitor androidScheme), but the
  embedded LocalMediaServer streams audio from http://127.0.0.1 only.
  Loopback cleartext is explicitly permitted; all other cleartext stays denied.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
