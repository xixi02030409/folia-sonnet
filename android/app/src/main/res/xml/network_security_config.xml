<?xml version="1.0" encoding="utf-8"?>
<!--
  Folia network policy:
  - The WebView page is served over https (Capacitor androidScheme); the embedded
    LocalMediaServer streams audio from http://127.0.0.1.
  - Users self-host backend services (KuGouMusicApi / Navidrome) on LAN addresses
    like http://192.168.x.x — plain HTTP must be permitted or every request from
    the WebView is blocked with ERR_CLEARTEXT_NOT_PERMITTED before it leaves the app.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
